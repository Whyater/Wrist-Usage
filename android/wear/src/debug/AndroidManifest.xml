<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application>
        <!-- Debug builds only: adb has to reach it to stand in for a paired phone on the emulator. -->
        <receiver
            android:name=".DebugSyncReceiver"
            android:exported="true"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="io.github.whyater.wristusage.DEBUG_INGEST" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
