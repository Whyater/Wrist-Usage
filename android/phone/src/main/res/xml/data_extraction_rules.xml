<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing here is backed up: the snapshot URL may be a private link, and the cache is rebuilt from it. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
